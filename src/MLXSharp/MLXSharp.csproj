<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>MLXSharp</AssemblyTitle>
    <Description>.NET bindings for Apple MLX with integrations for Microsoft.Extensions.AI and Semantic Kernel.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.9.1" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.65.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLXSharp.Native\MLXSharp.Native.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      IncludeAssets="none" />
  </ItemGroup>

  <!-- Include native binaries from MLXSharp.Native project into this package -->
  <ItemGroup>
    <None Include="..\MLXSharp.Native\runtimes\**\*.*"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
